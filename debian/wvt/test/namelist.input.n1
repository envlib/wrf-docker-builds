    sf_ocean_physics = 0
    sf_sfclay_physics = 1
    sf_surface_physics = 4
    sf_urban_physics = 0
    sst_skin = 0
    sst_update = 1
    tracer_pblmix = 1
    usemonalb = .true.
/

&fdda
/

&dynamics
