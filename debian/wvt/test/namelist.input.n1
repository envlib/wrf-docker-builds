&time_control
    adjust_output_times = .true.
    auxinput4_inname = 'wrflowinp_d<domain>'
    auxinput4_interval = 360
    io_form_auxinput8 = 2
    auxinput8_inname = 'trmask_d<domain>'
    end_day = 10
    end_hour = 3
    end_month = 2
    end_year = 2023
    frames_per_outfile = 1
    history_begin = 0
    history_interval = 60
    history_outname = 'wrfout_d<domain>_<date>.nc'
    input_from_file = .true.
    interval_seconds = 10800
    io_form_auxinput4 = 2
    io_form_boundary = 2
    io_form_history = 2
    io_form_input = 2
    io_form_restart = 2
    output_diagnostics = 0
    restart = .false.
    restart_interval = 500000
    run_days = 0
    run_hours = 0
    run_minutes = 0
    run_seconds = 0
    start_day = 10
    start_hour = 0
    start_month = 2
    start_year = 2023
/

&domains
    adaptation_domain = 1
    dx = 27000
    dy = 27000
    e_sn = 112
    e_vert = 33
    e_we = 100
    feedback = 0
    grid_id = 1
    i_parent_start = 1
    j_parent_start = 1
    max_dom = 1
    max_step_increase_pct = 5
    max_time_step = -1
    min_time_step = -1
    num_metgrid_levels = 38
    num_metgrid_soil_levels = 4
    p_top_requested = 5000
    parent_grid_ratio = 1
    parent_id = 1
    parent_time_step_ratio = 1
    smooth_option = 0
    starting_time_step = -1
    step_to_output_time = .true.
    target_cfl = 1.2
    time_step = 162
    time_step_fract_den = 1
    time_step_fract_num = 0
    use_adaptive_time_step = .true.
/

&physics
    bl_pbl_physics = 0
    bldt = 0
    cu_physics = 16
    cudt = 5
    icloud = 1
    mp_physics = 6
    num_land_cat = 21
