#wvt: activation scales with num_wvt_regions (regenerate with gen_wvt_tracers.py).
#     Region 1 stays gated on tracer_opt==4 (default num_wvt_regions=1 => exactly these 6
#     members, identical to the original single-region scheme). Regions 2..N are activated by
#     cumulative num_wvt_regions==N packages, so only 6*num_wvt_regions members are active.
#     2026-09-18: the NAMED per-region state fields (RTRQ*CUTEN_0n, tr_thum_*_0n) and the
#     region-1 / region-dimensioned WVT state are packaged the same way (wvt_cuten_nrN,
#     wvt_thum_nrN, wvt_state below) so a tracer-off run neither allocates nor writes them.
#     An inactive package field is a SIZE-1 DUMMY, not absent: every Fortran consumer is
#     gated on num_wvt_regions >= n and/or P_QV_TR (audit in the plan record,
#     wrf-model-eval). Registry/check_generators.sh asserts every packaged name is declared
#     and every WVT state field is packaged. DEFERRED (Stage 2b): region-1 RTRQ{V,C,R,I,S}CUTEN
#     stay unpackaged -- their only unguarded writers are KF/MSKF explicit-shape sites that a
#     bounds-checked build cannot see; they cost 3 zero history fields in a tracer-off run.
package   tracer_moist  tracer_opt==4       -             tracer:qv_tr,qc_tr,qr_tr,qi_tr,qs_tr,qg_tr
package   wvt_nr2        num_wvt_regions==2       -             tracer:qv_tr_02,qc_tr_02,qr_tr_02,qi_tr_02,qs_tr_02,qg_tr_02
package   wvt_nr3        num_wvt_regions==3       -             tracer:qv_tr_02,qc_tr_02,qr_tr_02,qi_tr_02,qs_tr_02,qg_tr_02,qv_tr_03,qc_tr_03,qr_tr_03,qi_tr_03,qs_tr_03,qg_tr_03
package   wvt_nr4        num_wvt_regions==4       -             tracer:qv_tr_02,qc_tr_02,qr_tr_02,qi_tr_02,qs_tr_02,qg_tr_02,qv_tr_03,qc_tr_03,qr_tr_03,qi_tr_03,qs_tr_03,qg_tr_03,qv_tr_04,qc_tr_04,qr_tr_04,qi_tr_04,qs_tr_04,qg_tr_04
package   wvt_nr5        num_wvt_regions==5       -             tracer:qv_tr_02,qc_tr_02,qr_tr_02,qi_tr_02,qs_tr_02,qg_tr_02,qv_tr_03,qc_tr_03,qr_tr_03,qi_tr_03,qs_tr_03,qg_tr_03,qv_tr_04,qc_tr_04,qr_tr_04,qi_tr_04,qs_tr_04,qg_tr_04,qv_tr_05,qc_tr_05,qr_tr_05,qi_tr_05,qs_tr_05,qg_tr_05
